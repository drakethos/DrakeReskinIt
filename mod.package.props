<Project>
  <PropertyGroup>
    <ThunderstoreName>DrakesReskinIt</ThunderstoreName>
    <ThunderstoreAuthor>DrakeMods</ThunderstoreAuthor>
    <RootNamespace>DrakesReskinIt</RootNamespace>
    <AssemblyName>DrakesReskinIt</AssemblyName>
    <Version>0.1.1</Version>
    <BepInPluginName>DrakesReskinIt</BepInPluginName>
    <BepInGuid>com.drakesworkshop.reskinit</BepInGuid>
    <ModInfoClass>ReskinItPlugin</ModInfoClass>
    <Description>Reskin items: new inventory icon, new equipped model (same kind of item) and custom colors, with presets. Shift + right-click an item, Reskin tab. Server admin/VIP rules, discovery and progression locks. Valheim 1.0 compatible.</Description>
    <WebsiteUrl>https://github.com/drakethos/DrakeReskinIt</WebsiteUrl>
  </PropertyGroup>
  <ItemGroup>
    <ThunderstoreDependency Include="denikson-BepInExPack_Valheim-5.4.2351" />
    <ThunderstoreDependency Include="ValheimModding-Jotunn-2.30.2" />
    <ThunderstoreDependency Include="DrakeMods-DrakeModsLibs-0.10.2" />
  </ItemGroup>
</Project>
