{
  "name": "R-21 known / unknown: holding an item unlocks its look in the grid",
  "description": "",
  "steps": [
    {
      "do": "setConfig",
      "values": {
        "03 - Features/RequireDiscovery": "Seen"
      }
    },
    {
      "do": "craft",
      "prefab": "AxeStone"
    },
    {
      "do": "itemClick",
      "prefab": "AxeStone",
      "index": 0,
      "mods": "Shift"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "click",
      "button": "Reskin"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "hook",
      "name": "reskin.windowOpen",
      "expect": true,
      "label": "the Reskin window is open",
      "stop": true
    },
    {
      "do": "hook",
      "name": "reskin.setFilter",
      "args": {
        "filter": "All"
      },
      "expect": true
    },
    {
      "do": "hook",
      "name": "reskin.cell",
      "args": {
        "look": "SwordSilver"
      },
      "contains": "Not discovered",
      "label": "unknown"
    },
    {
      "do": "click",
      "button": "Close"
    },
    {
      "do": "wait",
      "seconds": 0.2
    },
    {
      "do": "closeUi"
    },
    {
      "do": "give",
      "prefab": "SwordSilver"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "itemClick",
      "prefab": "AxeStone",
      "index": 0,
      "mods": "Shift"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "click",
      "button": "Reskin"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "hook",
      "name": "reskin.windowOpen",
      "expect": true,
      "label": "the Reskin window is open",
      "stop": true
    },
    {
      "do": "hook",
      "name": "reskin.setFilter",
      "args": {
        "filter": "All"
      },
      "expect": true
    },
    {
      "do": "hook",
      "name": "reskin.cell",
      "args": {
        "look": "SwordSilver"
      },
      "expect": "unlocked",
      "label": "known now"
    },
    {
      "do": "hook",
      "name": "reskin.pick",
      "args": {
        "look": "SwordSilver"
      },
      "expect": true
    },
    {
      "do": "click",
      "button": "Apply"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "hook",
      "name": "reskin.icon",
      "args": {
        "prefab": "AxeStone"
      },
      "contains": "SwordSilver",
      "label": "applied"
    },
    {
      "do": "click",
      "button": "Close"
    },
    {
      "do": "wait",
      "seconds": 0.2
    },
    {
      "do": "closeUi"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesReskinIt"
    }
  ]
}